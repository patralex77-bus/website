SECRET_KEY=change-this-secret-key
# DATABASE_URL=sqlite:///instance/austria_express.db

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now

MAX_CONTENT_LENGTH_MB=10

# Email Notification Settings
# Copy these values into .env or Render Environment Variables.

EMAIL_NOTIFICATIONS_ENABLED=true
PUBLIC_BASE_URL=http://127.0.0.1:5000

NOTIFICATION_TO=office@austria-express.eu
MAIL_FROM=office@austria-express.eu
MAIL_FROM_NAME=Austria Express Website

# Generic SMTP / SendGrid SMTP / Mailgun SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# SendGrid SMTP example:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USERNAME=apikey
# SMTP_PASSWORD=SG.xxxxx

# Mailgun SMTP example:
# SMTP_HOST=smtp.eu.mailgun.org
# SMTP_PORT=587
# SMTP_USERNAME=postmaster@mg.your-domain.com
# SMTP_PASSWORD=your-mailgun-smtp-password

