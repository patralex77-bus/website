# Render Environment Variables
# Copy these to Render dashboard or use render.yaml.

SECRET_KEY=generate-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now

# Use Render PostgreSQL External/Internal Database URL.
# Example:
# DATABASE_URL=postgresql://user:password@host:5432/database
DATABASE_URL=

MAX_CONTENT_LENGTH_MB=10
PUBLIC_BASE_URL=https://your-render-domain.onrender.com

# Email notifications
EMAIL_NOTIFICATIONS_ENABLED=false
NOTIFICATION_TO=office@austria-express.eu
MAIL_FROM=office@austria-express.eu
MAIL_FROM_NAME=Austria Express Website

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
